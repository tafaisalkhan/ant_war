; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Ant Colony Wars"
config/description="Level 1 - Forest Colony"
run/main_scene="res://scenes/ant_colony/Splash.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.15, 0.25, 0.17, 1)
boot_splash/show_image=false
boot_splash/stretch_mode=0
config/icon="res://assets/ant_colony/ui/app-icon.png"

[autoload]

GameProgress="*res://scripts/ant_colony/GameProgress.gd"
SoundManager="*res://scripts/ant_colony/SoundManager.gd"
MonetizationManager="*res://scripts/ant_colony/MonetizationManager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/handheld/orientation=4

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
